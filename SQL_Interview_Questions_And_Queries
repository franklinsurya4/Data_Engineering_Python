-- Q66. Find the second-highest salary in each department

WITH second_highest AS(    -- CTE (Common Table Expression)
SELECT emp_id,first_name,department_id,salary,
    DENSE_RANK() OVER (
        PARTITION BY department_id
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees
)
SELECT emp_id,first_name,department_id,salary
FROM second_highest
WHERE salary_rank = 2;

-- Q67. Find the top two salary ranks in each job

WITH top_two_salary_ranks AS (    -- CTE (Common Table Expression)
SELECT emp_id,first_name,department_id,job_id,salary,
    DENSE_RANK() OVER (
        PARTITION BY job_id
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees
)
SELECT emp_id,first_name,department_id,job_id,salary
FROM top_two_salary_ranks
WHERE salary_rank <= 2;

