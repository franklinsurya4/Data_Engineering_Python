7. Create prompts.py

File: py_de_ai_project/script/prompts.py

This file prepares the questions and data context sent to Gemini.

import json

def build_prompts(file_name, df, data_types,
                  column_profile, duplicates):

    # Use only a small sample, not the full dataset
    sample_json = df.head(10).astype(str).to_json(
        orient="records",
        indent=2,
        force_ascii=False
    )

    columns = df.columns.tolist()

    types_json = json.dumps(
        data_types,
        indent=2,
        ensure_ascii=False
    )

    profile_text = column_profile.to_json(
        orient="records",
        indent=2,
        force_ascii=False
    )

    common_context = f"""
File name: {file_name}

Total rows: {len(df)}
Total columns: {len(df.columns)}
Duplicate rows: {duplicates}

Column names:
{json.dumps(columns, ensure_ascii=False)}

Data types:
{types_json}

Column profile:
{profile_text}

Sample records:
{sample_json}
"""

    classification_prompt = f"""
You are a data governance specialist.

Analyze this dataset context:
{common_context}

Tasks:
1. Identify the likely business domain.
2. Identify potential PII columns.
3. Identify potentially confidential columns.
4. Recommend automated data quality rules.
5. Explain any assumptions and uncertainty.

Return a valid JSON object with these keys:
data_governance_domain,
pii_and_confidential_columns,
automated_data_quality_rules,
assumptions.

Do not claim that a column is confidential with certainty
without sufficient evidence. Return JSON only.
"""

    schema_prompt = f"""
You are a data engineering and data modeling specialist.

Analyze this dataset context:
{common_context}

Tasks:
1. Recommend a target analytical schema.
2. Suggest a likely primary key, if supported by evidence.
3. Suggest potential foreign keys, if supported by evidence.
4. Recommend column constraints and validation checks.
5. Identify information that needs business confirmation.

Return a valid JSON object with these keys:
recommended_schema,
primary_key_candidates,
foreign_key_candidates,
data_quality_constraints,
assumptions.

Do not invent relationships that the sample cannot establish.
Return JSON only.
"""

    return classification_prompt, schema_prompt


Why use two prompts?
- The classification prompt asks about governance and sensitive data.
- The schema prompt asks about data modeling and constraints.
Separating these tasks makes the output easier to review and maintain.


8. Create ai_client.py

File: py_de_ai_project/script/ai_client.py
This file connects to Gemini, sends the prompts, retries temporary errors, and checks whether the response is valid JSON.

import json
import time

from config import client, MODEL, PROJECT_FOLDER


def ask_gemini(prompt, max_retries=3):
    if client is None:
        raise RuntimeError(
            f"Gemini API client is not initialized. "
            f"Check your .env file at {PROJECT_FOLDER / '.env'}"
        )

    if not MODEL:
        raise RuntimeError(
            "GEMINI_MODEL is empty. Configure it in your .env file."
        )

    for attempt in range(1, max_retries + 1):
        try:
            print(
                f"Sending request to Gemini "
                f"(attempt {attempt}/{max_retries})..."
            )

            response = client.models.generate_content(
                model=MODEL,
                contents=prompt
            )

            if not response.text:
                raise RuntimeError("Gemini returned an empty response.")

            return response.text

        except Exception as error:
            message = str(error).upper()

            retryable = any(
                marker in message
                for marker in [
                    "503",
                    "UNAVAILABLE",
                    "429",
                    "RESOURCE_EXHAUSTED",
                    "500",
                    "INTERNAL"
                ]
            )

            if not retryable or attempt == max_retries:
                raise RuntimeError(
                    f"Gemini request failed: {error}"
                ) from error

            wait_seconds = attempt * 5
            print(
                f"Temporary service or quota issue. "
                f"Retrying in {wait_seconds} seconds..."
            )
            time.sleep(wait_seconds)


def parse_json_response(response_text):
    # Remove optional Markdown code fences
    cleaned = response_text.strip()

    if cleaned.startswith("```"):
        lines = cleaned.splitlines()

        if lines and lines[0].startswith("```"):
            lines = lines[1:]

        if lines and lines[-1].strip() == "```":
            lines = lines[:-1]

        cleaned = "\n".join(lines).strip()

        if cleaned.lower().startswith("json"):
            cleaned = cleaned[4:].strip()

    # Raise an error if Gemini did not return valid JSON
    return json.loads(cleaned)


Important: A working client only confirms that the client was initialized. API calls can still fail because of an unsupported model, quota limits, network errors, or temporary service issues.


9. Create data_profiler.py — the main pipeline

This is the main file that connects all the other Python files. You run this file to process your CSV from beginning to end.

File: py_de_ai_project/script/data_profiler.py

import json
import sys
from pathlib import Path

# Allow imports from this script folder
SCRIPT_FOLDER = Path(__file__).resolve().parent

if str(SCRIPT_FOLDER) not in sys.path:
    sys.path.insert(0, str(SCRIPT_FOLDER))

from config import LANDING, ARCHIVE, OUTPUT
from loader import load_dataframe
from profiler import profile_dataframe
from prompts import build_prompts
from ai_client import ask_gemini, parse_json_response


def save_json(data, output_file):
    with open(output_file, "w", encoding="utf-8") as file:
        json.dump(
            data,
            file,
            indent=4,
            ensure_ascii=False
        )

    print(f"Saved: {output_file}")


def run_pipeline(file_name="employee.csv"):
    # 1. Find the input file
    input_file = LANDING / file_name

    # Allow archived files to be used for testing
    if not input_file.exists():
        archived_file = ARCHIVE / file_name

        if archived_file.exists():
            input_file = archived_file
        else:
            raise FileNotFoundError(
                f"Input file not found: {LANDING / file_name}"
            )

    print("\n========== DATA ENGINEERING PIPELINE ==========")

    # 2. Load CSV
    df = load_dataframe(input_file)

    # 3. Generate data profile
    data_types, column_profile, duplicates = profile_dataframe(
        df,
        input_file.name
    )

    # 4. Build AI prompts
    classification_prompt, schema_prompt = build_prompts(
        input_file.name,
        df,
        data_types,
        column_profile,
        duplicates
    )

    # 5. Ask Gemini for governance recommendations
    print("\n--- Gemini: Data Governance Classification ---")
    classification_text = ask_gemini(classification_prompt)
    classification_result = parse_json_response(classification_text)

    # 6. Ask Gemini for schema recommendations
    print("\n--- Gemini: Analytical Schema ---")
    schema_text = ask_gemini(schema_prompt)
    schema_result = parse_json_response(schema_text)

    # 7. Save AI results as JSON
    classification_file = (
        OUTPUT / f"{input_file.stem}_governance.json"
    )

    schema_file = (
        OUTPUT / f"{input_file.stem}_schema.json"
    )

    save_json(classification_result, classification_file)
    save_json(schema_result, schema_file)

    # 8. Print a short summary
    print("\n========== PIPELINE SUMMARY ==========")
    print(f"Input file: {input_file.name}")
    print(f"Rows analyzed: {len(df)}")
    print(f"Columns analyzed: {len(df.columns)}")
    print(f"Duplicate rows: {duplicates}")
    print("Status: Completed successfully")
    print(f"Output directory: {OUTPUT}")


if __name__ == "__main__":
    try:
        run_pipeline("employee.csv")
    except Exception as error:
        print("\nPIPELINE FAILED")
        print(f"Reason: {error}")
        raise


How data_profiler.py works

1. Finds employee.csv in landing or, if absent, archive.
2. Loads the data into Pandas.
3. Creates the column-level profile CSV.
4. Builds the two prompts using prompts.py.
5. Calls Gemini twice: once for governance and once for schema recommendations.
6. Converts the responses to JSON and saves them in data/output.
This version deliberately does not move, archive, or delete the source file. That makes it safer to test while learning.


