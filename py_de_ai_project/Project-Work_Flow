5. Create loader.py

File: py_de_ai_project/script/loader.py

The loader reads your input CSV and converts it into a Pandas DataFrame.

import pandas as pd
from pathlib import Path


def load_dataframe(file_path):
    file_path = Path(file_path)

    if not file_path.exists():
        raise FileNotFoundError(
            f"CSV file not found: {file_path}"
        )

    if file_path.suffix.lower() != ".csv":
        raise ValueError("Only CSV files are supported.")

    df = pd.read_csv(file_path)

    if df.empty:
        raise ValueError("The CSV file has no data rows.")

    print(f"Loaded file: {file_path.name}")
    print(f"Rows: {len(df)}")
    print(f"Columns: {len(df.columns)}")

    return df


if __name__ == "__main__":
    test_file = Path(__file__).resolve().parent.parent / "landing" / "employee.csv"
    df = load_dataframe(test_file)
    print(df.head())


How it works:
1. Path(file_path) represents the file path.
2. exists() checks whether the file exists.
3. pd.read_csv() reads the data.
4. df.head() displays the first five rows.


6. Create profiler.py

File: py_de_ai_project/script/profiler.py

This file analyzes the dataset without using AI. It creates statistics that help identify data quality issues.

import pandas as pd
from pathlib import Path
from config import OUTPUT


def profile_dataframe(df, file_name):
    row_count = len(df)

    # Count missing values in each column
    null_counts = df.isnull().sum()

    # Calculate percentage of missing values
    if row_count > 0:
        null_percentage = (
            null_counts / row_count * 100
        ).round(2)
    else:
        null_percentage = null_counts

    # Create column-level profile
    column_profile = pd.DataFrame({
        "column_name": df.columns,
        "data_type": df.dtypes.astype(str).values,
        "null_count": null_counts.values,
        "actual_count": row_count,
        "unique_count": df.nunique().values,
        "null_percentage": null_percentage.values
    })

    # Count complete duplicate rows
    duplicates = int(df.duplicated().sum())

    # Save profile report
    profile_file = (
        OUTPUT / f"{Path(file_name).stem}_profile.csv"
    )

    column_profile.to_csv(profile_file, index=False)

    # Return information needed by the AI prompts
    data_types = df.dtypes.astype(str).to_dict()

    print(f"Profile saved to: {profile_file}")
    print(f"Total rows: {row_count}")
    print(f"Total columns: {len(df.columns)}")
    print(f"Duplicate rows: {duplicates}")

    return data_types, column_profile, duplicates


