## 5. Create loader.py

File: `py_de_ai_project/script/loader.py`

The loader reads the CSV file and converts it into a Pandas DataFrame.

```python
import pandas as pd
from pathlib import Path


def load_dataframe(file_path):
    file_path = Path(file_path)

    if not file_path.exists():
        raise FileNotFoundError(
            f"CSV file not found: {file_path}"
        )

    if file_path.suffix.lower() != ".csv":
        raise ValueError("Only CSV files are supported.")

    df = pd.read_csv(file_path)

    if df.empty:
        raise ValueError("The CSV file has no data rows.")

    print(f"Loaded file: {file_path.name}")
    print(f"Rows: {len(df)}")
    print(f"Columns: {len(df.columns)}")

    return df


if __name__ == "__main__":
    test_file = (
        Path(__file__).resolve().parent.parent
        / "landing"
        / "employee.csv"
    )

    df = load_dataframe(test_file)
    print(df.head())
```

### How It Works

1. `Path(file_path)` represents the CSV path.
2. `exists()` checks whether the file exists.
3. `pd.read_csv()` loads the CSV into a DataFrame.
4. `df.head()` displays the first five rows.

## 6. Create profiler.py

File: `py_de_ai_project/script/profiler.py`

This file performs statistical data profiling without using AI.

```python
import pandas as pd
from pathlib import Path
from config import OUTPUT


def profile_dataframe(df, file_name):
    row_count = len(df)

    # Count missing values per column
    null_counts = df.isnull().sum()

    # Calculate missing-value percentages
    if row_count > 0:
        null_percentage = (
            null_counts / row_count * 100
        ).round(2)
    else:
        null_percentage = null_counts

    # Build column-level profile
    column_profile = pd.DataFrame({
        "column_name": df.columns,
        "data_type": df.dtypes.astype(str).values,
        "null_count": null_counts.values,
        "actual_count": row_count,
        "unique_count": df.nunique().values,
        "null_percentage": null_percentage.values
    })

    # Count duplicate rows
    duplicates = int(df.duplicated().sum())

    # Save profile report
    profile_file = (
        OUTPUT / f"{Path(file_name).stem}_profile.csv"
    )

    column_profile.to_csv(profile_file, index=False)

    # Return data types, profile and duplicate count
    data_types = df.dtypes.astype(str).to_dict()

    print(f"Profile saved to: {profile_file}")
    print(f"Total rows: {row_count}")
    print(f"Total columns: {len(df.columns)}")
    print(f"Duplicate rows: {duplicates}")

    return data_types, column_profile, duplicates


if __name__ == "__main__":
    from loader import load_dataframe

    project_folder = Path(__file__).resolve().parent.parent
    input_file = project_folder / "landing" / "employee.csv"

    df = load_dataframe(input_file)
    profile_dataframe(df, input_file.name)
```

### Metrics Calculated

- `column_name`: Name of each column.
- `data_type`: Pandas data type.
- `null_count`: Number of missing values.
- `actual_count`: Total number of rows.
- `unique_count`: Number of distinct non-null values.
- `null_percentage`: Percentage of rows with missing values.
- `duplicates`: Number of completely duplicated rows, printed separately.

The `unique_count` metric excludes missing values by default.

