USE Franklin_employee_practice_db;

-- Q1. Display all employees
SELECT * FROM employees;

-- Q2. Display employee names and salaries
SELECT emp_id,first_name,last_name,salary 
FROM employees;

-- Q3. Find employees earning more than 5000
SELECT first_name,last_name,salary 
FROM employees 
WHERE salary>5000;

-- Q4. Find employees earning between 3000 and 7000
SELECT first_name,last_name,salary 
FROM employees 
WHERE salary 
BETWEEN 3000 AND 7000;

-- Q5. Find the five highest-paid employees
SELECT first_name,salary 
FROM employees 
ORDER BY salary DESC 
LIMIT 5;

-- Q6. Find employees without a manager
SELECT * FROM employees 
WHERE manager_id IS NULL;

-- Q7. Count employees in each department
SELECT department_id,COUNT(emp_id) AS emp_count 
FROM employees 
GROUP BY department_id; 

-- Q8. Find departments with more than five employees
SELECT department_id,COUNT(emp_id) AS emp_count 
FROM employees 
GROUP BY department_id 
HAVING COUNT(emp_id)>5;

-- Q9. Find the company average salary
SELECT AVG(salary) AS average_salary 
FROM employees;

-- Q10. Find employees earning above the company average
SELECT * FROM employees WHERE salary > (SELECT AVG(salary) FROM employees);

-- Q11. Find the second-highest distinct salary
SELECT MAX(salary) AS second_max_salary  
FROM employees 
WHERE salary < (SELECT MAX(salary) AS first_max_sal FROM employees);

-- Q12. Find employees earning above their department average
SELECT e.first_name,e.salary,e.department_id 
FROM employees e 
WHERE e.salary > (SELECT AVG(d.salary) 
FROM employees d 
WHERE e.department_id = d.department_id 
);

-- Q13. Display employee names and department names
SELECT e.first_name,e.last_name,d.department_name
FROM employees e JOIN departments d
ON e.department_id = d.department_id;

-- Q14. Display employee names and job titles
SELECT e.first_name,e.last_name,j.job_title 
FROM employees e JOIN jobs j 
ON e.job_id = j.job_id;

-- Q15. Find departments without employees
SELECT e.emp_id,d.department_id,d.department_name 
FROM employees e JOIN departments d
ON e.department_id = d.department_id
WHERE emp_id IS NULL;

-- Q16. Display employees and their managers
SELECT e.first_name AS emp_first_name,
       e.last_name AS emp_last_name,
       m.first_name AS mgr_first_name,
       m.last_name AS mgr_last_name
FROM employees e
LEFT JOIN employees m
ON e.manager_id = m.emp_id;

-- Q17. Find employees earning more than their managers
SELECT e.emp_id,e.first_name,e.last_name,e.salary,
       m.first_name AS mgr_first_name,
       m.last_name AS mgr_last_name,
       m.salary AS mgr_sal
FROM employees e 
JOIN employees m 
ON e.manager_id = m.emp_id
WHERE e.salary > m.salary;

-- Q18. Find the highest salary in each department
SELECT department_id, MAX(salary) AS highest_sal
FROM employees
GROUP BY department_id;

-- Q19. Rank employees by salary
SELECT emp_id,first_name,salary,
  DENSE_RANK() OVER (ORDER BY salary DESC) AS salary_rank
FROM employees;

-- Q20. Find the top three salary ranks in each department
SELECT emp_id,first_name,department_id,salary,
    DENSE_RANK() OVER (
        PARTITION BY department_id
        ORDER BY salary DESC) 
        AS salary_rank
FROM employees;

-- Q21. Find employees hired during 2022
SELECT emp_id,first_name,hire_date
FROM employees
WHERE hire_date >= '2022-01-01' AND hire_date <= '2022-12-31';

SELECT emp_id,first_name,hire_date
FROM employees
WHERE hire_date BETWEEN '2022-01-01' AND '2022-12-31';

-- Q22. Calculate years of service
SELECT emp_id,first_name,hire_date,
TIMESTAMPDIFF(YEAR,hire_date,CURDATE()) AS years_of_service
FROM employees;

-- Q23. Find duplicate email addresses
SELECT email, COUNT(*) AS occurrences
FROM employees
GROUP BY email
HAVING COUNT(*) > 1;

-- Q24. Find employee counts by job title
SELECT j.job_title,COUNT(e.emp_id) AS emp_count 
FROM employees e 
LEFT JOIN jobs j 
ON e.job_id = j.job_id
GROUP BY j.job_id,j.job_title;

-- Q25. Find average salary by city
SELECT l.city,AVG(e.salary) AS avg_sal
FROM locations l 
JOIN departments d ON l.location_id = d.location_id
JOIN employees e ON d.department_id = e.department_id
GROUP BY l.city;

-- Q26. Calculate annual salary
SELECT emp_id,first_name,salary,
    salary*12 AS annual_salary
FROM employees;

-- Q27. Replace missing commission with zero
SELECT emp_id,first_name,
   COALESCE(commission_pct, 0) AS commission_pct
FROM employees;

-- Q28. Find jobs without employees
SELECT j.job_id,j.job_title
FROM jobs j 
LEFT JOIN employees e
ON j.job_id = e.job_id
WHERE e.emp_id IS NULL;

-- Q29. Find each department's payroll
SELECT department_id,SUM(salary) AS total_payroll
FROM employees
GROUP BY department_id
ORDER BY total_payroll DESC;

-- Q30. Calculate cumulative payroll
SELECT emp_id,first_name,salary,
    SUM(salary) OVER (
        ORDER BY emp_id
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS cum_sal
FROM employees;

-- Q31. Find employees earning the lowest salary
SELECT emp_id,first_name,last_name,salary
FROM employees 
WHERE salary = (SELECT MIN(salary) FROM employees);

-- Q32. Find the third-highest distinct salary
SELECT DISTINCT(salary) FROM employees
ORDER BY salary DESC LIMIT 1 OFFSET 2;

SELECT MAX(salary) AS third_max_salary
FROM employees 
WHERE salary < 
    (SELECT MAX(salary) FROM employees
    WHERE salary < (SELECT MAX(salary) FROM employees));

-- Q33. Find employees earning above their job's average salary
SELECT e.first_name,e.email,e.salary 
FROM employees e
WHERE e.salary > (SELECT AVG(j.salary) FROM employees j
WHERE e.job_id = j.job_id);

-- Q34. Find employees earning the highest salary in each department
SELECT e.first_name,e.email,e.salary
FROM employees e
WHERE e.salary = (SELECT MAX(d.salary) AS highest_salary FROM employees d 
WHERE e.department_id = d.department_id);

-- Q35. Find employees earning the lowest salary in each department
SELECT e.first_name,e.email,e.department_id,e.salary
FROM employees e
WHERE e.salary = (SELECT MIN(d.salary) AS lowest_salary FROM employees d 
WHERE e.department_id = d.department_id);

-- Q36. Find departments with average salary above 7000
SELECT department_id,AVG(salary) AS average_salary
FROM employees
GROUP BY department_id
HAVING AVG(salary) > 7000;

-- Q37. Find departments with total payroll above 50000
SELECT department_id,SUM(salary) AS total_payroll
FROM employees
GROUP BY department_id
HAVING SUM(salary) > 50000;

-- Q38. Count employees for each job
SELECT job_id,COUNT(emp_id) AS emp_count
FROM employees
GROUP BY job_id; 

-- Q39. Find jobs with more than five employees
SELECT job_id,COUNT(emp_id) AS emp_count
FROM employees
GROUP BY job_id
HAVING COUNT(emp_id) > 5;

-- Q40. Find employees working in department 20
SELECT * FROM employees
WHERE department_id = 20;

SELECT first_name,last_name,department_id 
FROM employees
WHERE department_id=20;

-- Q41. Find employees whose first name starts with S
SELECT first_name 
FROM employees
WHERE first_name LIKE 'S%';

-- Q42. Find employees whose last name ends with n
SELECT last_name 
FROM employees
WHERE last_name LIKE '%n';

-- Q43. Find employees whose names contain 'an'
SELECT first_name
FROM employees
WHERE first_name LIKE '%an%';

SELECT last_name
FROM employees
WHERE last_name LIKE '%an%';

SELECT first_name,last_name
FROM employees
WHERE first_name LIKE '%an%' OR last_name LIKE '%an%';

-- Q44. Find employees hired before 2020
SELECT * FROM employees
WHERE hire_date < '2020-01-01';

-- Q45. Find employees hired in the last five years
SELECT * FROM employees
WHERE hire_date >= DATE_SUB(NOW(),INTERVAL 5 YEAR);

-- Q46. Display employee names in uppercase
SELECT UPPER(first_name) AS first_name_upper,UPPER(last_name) AS second_name_upper
FROM employees;

-- Q47. Display full names
SELECT CONCAT(first_name,' ',last_name) AS full_name
FROM employees;

-- Q48. Find employees with missing commission
SELECT * FROM employees
WHERE commission_pct IS NULL;

-- Q49. Find employees with commission greater than zero
SELECT * FROM employees
WHERE commission_pct > 0;

-- Q50. Calculate a 10% salary increase
SELECT emp_id,first_name,last_name,salary,
ROUND(salary*1.10,2) AS increased_salary
FROM employees;

-- Q51. Find employees whose salary is outside their job salary range
SELECT e.emp_id,e.first_name,e.salary,j.job_title,j.min_salary,j.max_salary
FROM employees e 
JOIN jobs j
ON e.job_id = j.job_id
WHERE e.salary < j.min_salary
OR e.salary > j.max_salary;

-- Q52. Find employees whose salary is within their job salary range
SELECT e.emp_id,e.first_name,e.salary,j.job_title,j.min_salary,j.max_salary
FROM employees e
JOIN jobs j
ON e.job_id=j.job_id
WHERE e.salary BETWEEN j.min_salary AND j.max_salary;

-- Q53. Display departments and their locations
SELECT d.department_id,d.department_name,l.city
FROM departments d 
LEFT JOIN locations l 
ON d.location_id=l.location_id; 

-- Q54. Find employees working in Chennai
SELECT e.emp_id,e.first_name,d.department_id,l.city
FROM employees e 
JOIN departments d ON e.department_id=d.department_id
JOIN locations l ON d.location_id=l.location_id
WHERE l.city='Chennai';

-- Q55. Find departments without employees (without means NULL)
SELECT d.department_id,d.department_name,e.emp_id
FROM departments d
JOIN employees e 
ON e.department_id=d.department_id
WHERE e.emp_id IS NULL;

-- Q56. Find jobs without employees
SELECT j.job_id,j.job_title,e.emp_id AS emp_id
FROM jobs j
LEFT JOIN employees e
ON j.job_id=e.job_id
WHERE e.emp_id IS NULL;

-- Q57. Count departments in each city
SELECT l.city,COUNT(d.department_id)
FROM departments d
LEFT JOIN locations l
ON d.location_id=l.location_id
GROUP BY l.city;

-- Q58. Find employees earning more than employee 11
SELECT emp_id,first_name,department_id,salary 
FROM employees
WHERE salary > (SELECT salary FROM employees
WHERE emp_id=11
);

-- Q59. Find employees with the same job as employee 11
SELECT emp_id,first_name,department_id,job_id
FROM employees
