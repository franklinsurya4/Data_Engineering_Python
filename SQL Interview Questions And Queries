HAVING COUNT(*) > 1;

-- Q80. Find the department with the highest payroll
SELECT d.department_id,d.department_name,
    SUM(e.salary) AS total_payroll
FROM departments d 
JOIN employees e
ON d.department_id = e.department_id
GROUP BY department_id,department_name
ORDER BY total_payroll DESC
LIMIT 1;

-- Q81. Find employees earning more than their department's average salary
SELECT e.emp_id,e.first_name,e.last_name,e.salary
FROM employees e
WHERE e.salary > (SELECT AVG(e2.salary) FROM employees e2
WHERE e.department_id = e2.department_id);

-- using joins/alias name

SELECT e.emp_id, e.first_name, e.last_name, e.salary
FROM employees e
JOIN departments d
ON e.department_id = d.department_id
GROUP BY e.emp_id, e.first_name, e.last_name, e.salary, e.department_id
HAVING e.salary > (
SELECT AVG(e2.salary)
   FROM employees e2
   WHERE e2.department_id = e.department_id
);

-- Q82. Find employees earning less than their department's average salary

SELECT e.emp_id,e.first_name,e.last_name,e.salary
FROM employees e
WHERE e.salary < (SELECT AVG(e2.salary) FROM employees e2
WHERE e.department_id = e2.department_id);


SELECT e.emp_id,e.first_name,e.last_name,e.salary
FROM employees e
JOIN departments d 
ON e.department_id = d.department_id
GROUP BY e.emp_id,e.first_name,e.last_name,e.department_id
HAVING e.salary < ( SELECT AVG(e2.salary) FROM employees e2
WHERE e.department_id = e2.department_id);
