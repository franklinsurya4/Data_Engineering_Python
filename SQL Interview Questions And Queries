-- Q61. Find employees who are managers
SELECT DISTINCT m.emp_id,m.first_name,m.job_id
FROM employees m  
JOIN employees e 
ON m.emp_id=e.manager_id;

-- Q62. Find employees who are not managers
SELECT emp_id,first_name,job_id
FROM employees
WHERE NOT job_id='MGR';

SELECT emp_id, first_name, job_id
FROM employees
WHERE job_id <> 'MGR';

-- Q64. Find employees earning more than their department average
SELECT e.emp_id,e.first_name,e.salary
FROM employees e
WHERE e.salary > (SELECT AVG(d.salary) FROM employees d
WHERE e.department_id=d.department_id);

SELECT emp_id,first_name,salary
FROM employees
WHERE salary > (SELECT AVG(salary) FROM employees);

-- Q65. Rank employees by salary within each department
SELECT emp_id,first_name,salary,
    DENSE_RANK() OVER(
        PARTITION BY department_id
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees;


SELECT emp_id,first_name,salary,
    RANK() OVER(
        PARTITION BY department_id
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees;

-- Q66. Find the second-highest salary in each department
WITH second_highest AS(
SELECT emp_id,first_name,department_id,salary,
    DENSE_RANK() OVER (
        PARTITION BY department_id
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees
)
SELECT emp_id,first_name,department_id,salary
FROM second_highest
WHERE salary_rank = 2;

-- Q67. Find the top two salary ranks in each job
WITH top_two_salary_ranks AS (
SELECT emp_id,first_name,department_id,job_id,salary,
    DENSE_RANK() OVER (
        PARTITION BY job_id
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees
)
SELECT emp_id,first_name,department_id,job_id,salary
FROM top_two_salary_ranks
WHERE salary_rank <= 2;

-- Q68. Display salary and department average side by side
SELECT emp_id,first_name,salary,
    AVG(salary) OVER (
        PARTITION BY department_id
    ) AS average_salary
FROM employees;

-- Q69. Compare each salary with the previous salary by employee ID
SELECT emp_id,first_name,salary,
LAG(salary) OVER (
        ORDER BY emp_id
    ) AS previous_salary
FROM employees;

-- Q70. Compare each salary with the next salary by employee ID
SELECT emp_id,first_name,salary,
    LEAD(salary) OVER (
        ORDER BY emp_id
    ) AS next_salary
FROM employees;

-- Q71. Assign row numbers by salary, highest first
SELECT emp_id,first_name,salary,
    ROW_NUMBER() OVER (
        ORDER BY salary DESC
    ) AS row_numbers_salary
FROM employees;

-- Q72. Divide employees into four salary groups
SELECT emp_id,first_name,salary,
    NTILE(4) OVER (
        ORDER BY salary DESC
    ) AS divide_salary
FROM employees;

-- Q73. Calculate each employee's percentage of total payroll
SELECT emp_id,first_name,salary,
    ROUND(salary*100.0 / SUM(salary) OVER(),2) AS total_payroll_percent
FROM employees;

-- Q74. Count employees hired in each year
SELECT
    YEAR(hire_date) AS hire_year,
    COUNT(*) AS total_employees
FROM employees
GROUP BY YEAR(hire_date)
ORDER BY hire_year;

-- Q75. Calculate payroll by hire year
SELECT 
    YEAR(hire_date) AS hire_year,
    SUM(salary) AS total_payroll
FROM employees
GROUP BY YEAR(hire_date)
ORDER BY hire_year;

