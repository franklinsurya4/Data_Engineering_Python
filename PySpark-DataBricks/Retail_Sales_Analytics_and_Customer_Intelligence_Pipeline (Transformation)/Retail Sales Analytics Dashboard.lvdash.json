      "name": "bd69c084",
      "displayName": "Retail_Sales_Summary_1",
      "config": {
        "version": "1.1",
        "source": "SELECT *\r\nFROM workspace.default.retail_sales_detail\r\nLIMIT 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "935328e9",
      "displayName": "Retail Sales Summary Metrics Overview",
      "queryLines": [
        "SELECT\r\n",
        "    ROUND(SUM(net_revenue), 2) AS total_revenue,\r\n",
        "    COUNT(DISTINCT order_id) AS total_orders,\r\n",
        "    COUNT(DISTINCT customer_id) AS total_customers,\r\n",
        "    SUM(quantity) AS total_units_sold\r\n",
        "FROM workspace.default.retail_delivered_sales"
      ]
    },
    {
