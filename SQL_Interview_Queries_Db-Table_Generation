-- ============================================================
-- STEP 12: BASIC RELATIONSHIP CHECK
-- ============================================================

SELECT
    e.employee_id,
    e.first_name,
    e.last_name,
    e.salary,
    j.job_title,
    d.department_name,
    l.city
FROM employees e
LEFT JOIN jobs j
    ON e.job_id = j.job_id
LEFT JOIN departments d
    ON e.department_id = d.department_id
LEFT JOIN locations l
    ON d.location_id = l.location_id
ORDER BY e.employee_id;
