CREATE DATABASE IF NOT EXISTS franklin_employee_practice_db;

USE franklin_employee_practice_db;

-- ============================================================
-- STEP 1: DROP OLD TABLES IF THEY EXIST
-- WARNING: This deletes the existing tables and their data.
-- ============================================================

DROP TABLE IF EXISTS employees;
DROP TABLE IF EXISTS departments;
DROP TABLE IF EXISTS jobs;
DROP TABLE IF EXISTS locations;


-- ============================================================
-- STEP 2: CREATE LOCATIONS TABLE
-- ============================================================

CREATE TABLE locations (
    location_id INT PRIMARY KEY,
    street_address VARCHAR(150),
    postal_code VARCHAR(20),
    city VARCHAR(100),
    state_province VARCHAR(100),
    country_id VARCHAR(10)
);


-- ============================================================
-- STEP 3: CREATE JOBS TABLE
-- VARCHAR supports both job codes such as IT_PROG and
-- numeric-looking IDs such as '5' used in practice queries.
-- ============================================================

CREATE TABLE jobs (
    job_id VARCHAR(20) PRIMARY KEY,
    job_title VARCHAR(100) NOT NULL,
    min_salary DECIMAL(10,2),
    max_salary DECIMAL(10,2)
);


-- ============================================================
-- STEP 4: CREATE DEPARTMENTS TABLE
-- ============================================================

CREATE TABLE departments (
    department_id INT PRIMARY KEY,
    department_name VARCHAR(100) NOT NULL,
    manager_id INT,
    location_id INT
);


-- ============================================================
-- STEP 5: CREATE EMPLOYEES TABLE
-- ============================================================

CREATE TABLE employees (
    employee_id INT PRIMARY KEY,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    email VARCHAR(150),
    phone_number VARCHAR(30),
    hire_date DATE,
    job_id VARCHAR(20),
    salary DECIMAL(10,2),
    commission_pct DECIMAL(5,2),
    manager_id INT,
    department_id INT
);


